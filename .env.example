# 資料庫連線字串
# 在 Railway 部署環境的 Variables 中，請設定為：${{Postgres.DATABASE_URL}}
# 本機開發測試時可填入 Railway Postgres 公開連線字串（或留空改用本地檔案儲存）
DATABASE_URL=""

# 站點 URL (用於 SEO 與 OpenGraph 生成)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# 管理員密鑰 (用於受保護 API 與管理後台認證，請自行設定強密鑰)
ADMIN_SECRET_KEY="your-secure-admin-secret-key"

# 電子郵件發送服務 (選用)
RESEND_API_KEY=""

